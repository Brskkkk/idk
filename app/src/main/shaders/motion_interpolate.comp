#version 450
// Reference Vulkan compute kernel for the next stage of FrameFlow.
// One vector is intended to be estimated per 8x8 block, then reused for
// the pixels inside that block. This file is intentionally kept separate
// from the CPU reference path until the Vulkan AHardwareBuffer import and
// synchronization path is validated on-device.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D prevFrame;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D nextFrame;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outFrame;

float luma(vec4 c) { return dot(c.rgb, vec3(0.299, 0.587, 0.114)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outFrame);
    if (any(greaterThanEqual(p, size))) return;

    // The production implementation will read a shared 8x8 motion-vector
    // field generated by a dedicated block-matching pass.
    // This conservative fallback is intentionally just temporal blending.
    vec4 a = imageLoad(prevFrame, p);
    vec4 b = imageLoad(nextFrame, p);
    vec4 o = mix(a, b, 0.5);
    o.a = 1.0;
    imageStore(outFrame, p, o);
}
